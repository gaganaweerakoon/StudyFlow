<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="top" android:padding="14dp"
    android:background="@drawable/widget_focus_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <TextView android:id="@+id/widget_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:text="StudyFlow" android:textSize="13sp" android:textStyle="bold" android:textColor="#FFFFFF"/>
        <TextView android:id="@+id/widget_sync" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="↻ —" android:textColor="#AEADBC" android:textSize="10sp" android:maxLines="1"/>
    </LinearLayout>
    <TextView android:id="@+id/widget_phase" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
        android:text="Ready" android:textColor="#BFB9FF" android:textSize="11sp" android:textStyle="bold"/>
    <TextView android:id="@+id/widget_session" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Ready to study" android:textSize="15sp" android:textStyle="bold" android:textColor="#FFFFFF" android:maxLines="1" android:ellipsize="end"/>
    <Chronometer android:id="@+id/widget_timer" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:format="%s" android:text="25:00" android:textSize="30sp" android:textStyle="bold" android:textColor="#FFFFFF"/>
    <ProgressBar android:id="@+id/widget_progress" android:layout_width="match_parent" android:layout_height="3dp"
        android:layout_marginTop="2dp" style="?android:attr/progressBarStyleHorizontal" android:indeterminate="false"
        android:max="1000" android:progress="0" android:progressTint="#8E85FF" android:progressBackgroundTint="#4435354B"/>
    <TextView android:id="@+id/widget_upcoming_label" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="10dp" android:text="UP NEXT" android:textSize="10sp" android:textStyle="bold" android:textColor="#AEADBC"/>
    <TextView android:id="@+id/widget_next" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="No upcoming study sessions" android:textSize="12sp" android:textColor="#FFFFFF" android:maxLines="1" android:ellipsize="end"/>
    <TextView android:id="@+id/widget_next2" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="3dp" android:textSize="12sp" android:textColor="#FFFFFF" android:maxLines="1" android:ellipsize="end"/>
</LinearLayout>