rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: deny all unmatched paths by default.
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isVerifiedOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    function isValidTheme(val) {
      return val is string && val in ['light', 'dark', 'midnight', 'ocean', 'forest', 'warm'];
    }

    function isValidDensity(val) {
      return val is string && val in ['compact', 'comfortable'];
    }

    function isValidPhotoUrl(val) {
      return val is string && val.size() <= 1024 && (val == '' || val.matches('^https://.+'));
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'email', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'uid',
          'displayName',
          'email',
          'photoURL',
          'major',
          'theme',
          'accentColor',
          'density',
          'dailyGoalHours',
          'weeklyGoalHours',
          'createdAt',
          'updatedAt'
        ])
        && data.uid is string
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.uid == userId
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 120
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 254
        && data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && (!('photoURL' in data) || isValidPhotoUrl(data.photoURL))
        && (!('major' in data) || (data.major is string && data.major.size() <= 160))
        && (!('theme' in data) || isValidTheme(data.theme))
        && (!('accentColor' in data) || (data.accentColor is string && data.accentColor.size() <= 16 && data.accentColor.matches('^#[0-9a-fA-F]{6}$')))
        && (!('density' in data) || isValidDensity(data.density))
        && (!('dailyGoalHours' in data) || ((data.dailyGoalHours is int || data.dailyGoalHours is float) && data.dailyGoalHours >= 0.5 && data.dailyGoalHours <= 24))
        && (!('weeklyGoalHours' in data) || ((data.weeklyGoalHours is int || data.weeklyGoalHours is float) && data.weeklyGoalHours >= 1 && data.weeklyGoalHours <= 168))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /users/{userId} {
      // PII-isolated: only the owner may read their own profile. No listing/enumeration.
      allow get: if isSignedIn() && request.auth.uid == userId && isValidId(userId);
      allow list: if false;

      allow create: if isVerifiedOwner(userId)
        && isValidId(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedOwner(userId)
        && isValidId(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName',
          'email',
          'photoURL',
          'major',
          'theme',
          'accentColor',
          'density',
          'dailyGoalHours',
          'weeklyGoalHours',
          'updatedAt'
        ]);

      allow delete: if isVerifiedOwner(userId) && isValidId(userId);
    }
  }
}
