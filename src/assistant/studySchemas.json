{
  "flashcards": {
    "type": "object",
    "required": ["items"],
    "properties": {
      "items": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["front", "back"],
          "properties": { "front": { "type": "string" }, "back": { "type": "string" } }
        }
      }
    }
  },
  "practice": {
    "type": "object",
    "required": ["items"],
    "properties": {
      "items": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["type", "prompt", "answer", "explanation"],
          "properties": {
            "type": { "type": "string", "enum": ["mcq", "multi", "short"] },
            "prompt": { "type": "string" },
            "options": { "type": "array", "items": { "type": "string" } },
            "answer": { "anyOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" } }] },
            "explanation": { "type": "string" },
            "rubric": { "type": "string" }
          }
        }
      }
    }
  },
  "syllabus": {
    "type": "object",
    "required": ["items"],
    "properties": {
      "items": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["title", "topics"],
          "properties": { "title": { "type": "string" }, "topics": { "type": "array", "items": { "type": "string" } } }
        }
      }
    }
  },
  "grading": {
    "type": "object",
    "required": ["items"],
    "properties": {
      "items": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["id", "correct", "feedback"],
          "properties": { "id": { "type": "string" }, "correct": { "type": "boolean" }, "feedback": { "type": "string" } }
        }
      }
    }
  },
  "overview": {
    "type": "object",
    "required": [
      "headline",
      "summary",
      "focusPriority",
      "scheduleTip",
      "advice"
    ],
    "properties": {
      "headline": {
        "type": "string",
        "description": "Crisp 5-10 word headline summarizing the student’s study state today."
      },
      "summary": {
        "type": "string",
        "description": "2 concise sentences analyzing their real workload, deadlines, progress, and weak spots."
      },
      "focusPriority": {
        "type": "string",
        "description": "Single highest-leverage subject/task/exam to work on next."
      },
      "scheduleTip": {
        "type": "string",
        "description": "Concrete scheduling recommendation referencing their real open time slots or workload."
      },
      "advice": {
        "type": "array",
        "description": "2 to 3 concrete, actionable recommendations.",
        "items": {
          "type": "object",
          "required": [
            "title",
            "detail",
            "impact",
            "actionType",
            "actionLabel"
          ],
          "properties": {
            "title": {
              "type": "string"
            },
            "detail": {
              "type": "string"
            },
            "impact": {
              "type": "string",
              "enum": [
                "high",
                "medium",
                "quick"
              ]
            },
            "actionType": {
              "type": "string",
              "enum": [
                "ask_pip",
                "open_planner",
                "open_flashcards",
                "open_practice",
                "open_tasks",
                "open_notes",
                "start_focus"
              ]
            },
            "actionLabel": {
              "type": "string",
              "description": "Short 2-4 word button label (e.g., \"Schedule with Pip\", \"Review Due Cards\", \"Start Practice Test\")."
            },
            "prompt": {
              "type": "string",
              "description": "When actionType is ask_pip, a concrete prompt to send to Pip so Pip executes or coaches immediately."
            }
          }
        }
      }
    }
  },
  "syllabus_bundle": {
    "type": "object",
    "required": ["exams", "tasks", "chapters", "goals"],
    "properties": {
      "courseTitle": { "type": "string" },
      "exams": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["title", "date", "weightPercent"],
          "properties": {
            "title": { "type": "string" },
            "date": { "type": "string", "description": "YYYY-MM-DD if known or best inferred academic date." },
            "time": { "type": "string" },
            "room": { "type": "string" },
            "weightPercent": { "type": "number" },
            "syllabusTopics": { "type": "array", "items": { "type": "string" } }
          }
        }
      },
      "tasks": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["title", "dueDate", "priority", "estimatedMinutes"],
          "properties": {
            "title": { "type": "string" },
            "dueDate": { "type": "string", "description": "YYYY-MM-DD" },
            "priority": { "type": "string", "enum": ["low", "medium", "high"] },
            "estimatedMinutes": { "type": "integer" },
            "description": { "type": "string" }
          }
        }
      },
      "chapters": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["title", "topics"],
          "properties": {
            "title": { "type": "string" },
            "topics": { "type": "array", "items": { "type": "string" } }
          }
        }
      },
      "goals": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["title", "deadline", "category", "milestones"],
          "properties": {
            "title": { "type": "string" },
            "deadline": { "type": "string" },
            "category": { "type": "string", "enum": ["daily", "weekly", "subject", "tasks", "syllabus", "revision"] },
            "milestones": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["label", "date"],
                "properties": {
                  "label": { "type": "string" },
                  "date": { "type": "string" }
                }
              }
            }
          }
        }
      }
    }
  }
}
