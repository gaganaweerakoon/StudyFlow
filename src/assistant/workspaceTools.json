  {
    "name": "create_goal",
    "description": "Create a study goal, with optional milestones. Use milestoneSteps for one request with separate dates and titles.",
    "parameters": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "target": {
          "type": "number",
          "description": "Numeric target value (e.g., 10, 100). Defaults to 100."
        },
        "unit": {
          "type": "string",
          "description": "Unit such as 'hours', 'chapters', 'cards', '%', or 'problems'."
        },
        "deadline": {
          "type": "string",
          "description": "Optional deadline in YYYY-MM-DD or short label."
        },
        "category": {
          "type": "string",
          "enum": [
            "daily",
            "weekly",
            "subject",
            "tasks",
            "syllabus",
            "revision"
          ]
        },
        "subjectId": {
          "type": "string"
        },
        "milestones": {
          "type": "array",
          "description": "Optional milestone step titles for this goal.",
          "items": {
            "type": "string"
          }
        },
        "milestoneSteps": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string"
              },
              "date": {
                "type": "string"
              }
            },
            "required": [
              "title"
            ]
          }
        }
      },
      "required": [
        "title"
      ]
    }
  },
