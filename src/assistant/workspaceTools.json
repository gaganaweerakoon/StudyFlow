[
  {
    "name": "create_event",
    "description": "Schedule a new study session, class, sleep block, or free block on the StudyFlow calendar.",
    "parameters": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "description": "Title of the calendar event or study block."
        },
        "date": {
          "type": "string",
          "description": "Local start date in YYYY-MM-DD format."
        },
        "startHour": {
          "type": "number",
          "description": "Start time as 24-hour decimal (e.g., 9.5 for 09:30, 14 for 14:00, 19.25 for 19:15)."
        },
        "startTime": {
          "type": "string",
          "description": "Optional alternative start time in HH:MM 24-hour format (e.g., '14:30')."
        },
        "durationHours": {
          "type": "number",
          "description": "Duration in hours (e.g., 1, 1.5, 2). Defaults to 1 if omitted."
        },
        "subjectId": {
          "type": "string",
          "description": "Optional matching subject ID or subject code from workspace context."
        },
        "blockType": {
          "type": "string",
          "enum": [
            "study",
            "sleep",
            "free"
          ],
          "description": "Block category. Defaults to 'study'."
        },
        "location": {
          "type": "string",
          "description": "Optional room or location."
        },
        "notes": {
          "type": "string",
          "description": "Optional session agenda or study notes."
        },
        "weekdays": {
          "type": "array",
          "description": "Optional repeating weekdays using Monday=0 through Sunday=6. Include all 7 for daily recurrence.",
          "items": {
            "type": "integer"
          }
        }
      },
      "required": [
        "title",
        "date"
      ]
    }
  },
  {
    "name": "update_event",
    "description": "Update an existing calendar session or recurring series.",
    "parameters": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Existing session ID from workspace context."
        },
        "scope": {
          "type": "string",
          "enum": [
            "occurrence",
            "series"
          ],
          "description": "Required when editing a recurring event."
        },
        "title": {
          "type": "string"
        },
        "date": {
          "type": "string",
          "description": "YYYY-MM-DD"
        },
        "startHour": {
          "type": "number"
        },
        "startTime": {
          "type": "string",
          "description": "HH:MM"
        },
        "durationHours": {
          "type": "number"
        },
        "subjectId": {
          "type": "string"
        },
        "blockType": {
          "type": "string",
          "enum": [
            "study",
            "sleep",
            "free"
          ]
        },
        "weekdays": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        }
      },
      "required": [
        "id"
      ]
    }
  },
  {
    "name": "delete_event",
    "description": "Delete a single existing calendar event by ID or by title (with optional date/time). StudyFlow will ask the student to confirm before deleting.",
    "parameters": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Existing session ID from workspace context."
        },
        "title": {
          "type": "string",
          "description": "Event title if ID is not known."
        },
        "date": {
          "type": "string",
          "description": "Optional YYYY-MM-DD date to disambiguate matching events."
        },
        "startTime": {
          "type": "string",
          "description": "Optional HH:MM 24-hour start time to disambiguate matching events."
        },
        "scope": {
          "type": "string",
          "enum": [
            "occurrence"
          ],
          "description": "For recurring events, removes this occurrence only."
        }
      }
    }
  },
  {
    "name": "delete_events",
    "description": "Delete multiple calendar events at once (e.g. clear a whole day or remove all events matching a keyword or list of IDs). StudyFlow will ask the student to confirm before deleting.",
    "parameters": {
      "type": "object",
      "properties": {
        "ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Optional list of specific session IDs to delete."
        },
        "date": {
          "type": "string",
          "description": "Optional YYYY-MM-DD date to delete all matching events on that day."
        },
        "titleContains": {
          "type": "string",
          "description": "Optional case-insensitive title keyword to filter events to delete."
        },
        "blockType": {
          "type": "string",
          "enum": [
            "study",
            "sleep",
            "free"
          ],
          "description": "Optional block category filter."
        }
      }
    }
  },
